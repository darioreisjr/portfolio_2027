{
  "name": "@portfolio/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/ds.js"
    },
    "./react": {
      "types": "./react.d.ts"
    }
  },
  "scripts": {
    "dev": "vite build -c vite.lib.config.ts --watch",
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "lit": "catalog:"
  },
  "devDependencies": {
    "@portfolio/config": "workspace:*",
    "@portfolio/tokens": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/web-components-vite": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
