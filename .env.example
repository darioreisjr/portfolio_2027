# Copie para .env e preencha. O arquivo .env nunca é versionado.
# Claude Code e Codex leem estas variáveis do ambiente do terminal;
# o Gemini CLI também carrega o .env da raiz sozinho.

# Chave da API do Context7 (documentação de bibliotecas): https://context7.com
CONTEXT7_API_KEY=

# Token pessoal do GitHub, de preferência fine-grained e restrito a este repositório
GITHUB_PERSONAL_ACCESS_TOKEN=

# Segredos para deploy na Vercel (opcionais localmente, necessários nos Secrets do GitHub Actions)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Projeto de produção na Vercel. No GitHub é segredo do ambiente `production` (ADR 0014)
VERCEL_PROJECT_ID_PRODUCTION=

# Google Gemini API (assistente mascote virtual na Serverless Function /api/chat - ADR 0016)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
