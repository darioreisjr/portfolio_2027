# Copie para .env e preencha. O arquivo .env nunca é versionado.
# Claude Code e Codex leem estas variáveis do ambiente do terminal, não do .env:
# defina-as também no ambiente do seu usuário (veja o GUIA, passo "Segredos").

# Chave da API do Context7 (documentação de bibliotecas): https://context7.com
CONTEXT7_API_KEY=

# Token pessoal do GitHub, fine-grained e restrito a este repositório
GITHUB_PERSONAL_ACCESS_TOKEN=
